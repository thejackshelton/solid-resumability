{
  "name": "unplugin-solid-resumability",
  "version": "0.1.0",
  "description": "Comptime resumability for Solid, as a bundler plugin: prove components at build time, ship artifacts instead of a hydration pass",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "default": "./dist/rollup.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "default": "./dist/rolldown.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "default": "./dist/webpack.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "default": "./dist/rspack.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "default": "./dist/esbuild.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./runtime/*": "./dist/runtime/*.js",
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "jsdom": "30.0.1",
    "pathe": "2.0.3",
    "unplugin": "3.3.0",
    "yuku-analyzer": "0.8.5",
    "yuku-codegen": "0.8.5",
    "yuku-parser": "0.8.5"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "magic-regexp": "0.11.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
